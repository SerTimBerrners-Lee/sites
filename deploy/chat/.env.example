# Server-only settings. Never put secrets in the public chat/ folder.
HOST=127.0.0.1
PORT=3002
# Site: https://pksep.ru/chat/
# Origin has no path: do NOT append /chat/ here.
ALLOWED_ORIGINS=https://pksep.ru
TRUST_PROXY=true

SMTP_HOST=smtp.majordomo.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@pksep.ru
# DevOps fills the mailbox password on the server only.
SMTP_PASSWORD=""
# Generate a separate Chat secret with: openssl rand -hex 32
LEADS_HMAC_SECRET=""
LEADS_DB_PATH=/var/lib/sep-chat/leads.sqlite
MAIL_FROM=info@pksep.ru
MAIL_TO=info@pksep.ru

LEADS_RATE_LIMIT=5
LEADS_GLOBAL_RATE_LIMIT=100
LEADS_MIN_FORM_MS=2000
LEADS_MAX_CONCURRENT=3
