# Site: https://pksep.ru/chat/; API: https://pksep.ru/api/chat/leads.
# Add at server level in the existing pksep.ru HTTPS block, NOT inside /chat/.
# Keep ERP /api/leads intact.
# Publish ONLY chat/ as static files. Never serve backend/, deploy/, ENV or SQLite.
# Omit these two rules if already defined by the ERP configuration.
location ^~ /backend/ { return 404; }
location ^~ /deploy/ { return 404; }

location = /api/chat/leads {
    client_max_body_size 8k;
    client_body_timeout 10s;
    proxy_pass http://127.0.0.1:3002;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 40s;
    proxy_send_timeout 10s;
    proxy_intercept_errors off;
}
