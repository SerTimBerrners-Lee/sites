# Server-only configuration. Copy to /etc/sep-erp/mail.env, never to ERP/.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=https://pksep.ru
# Enable only behind a loopback reverse proxy which replaces X-Real-IP.
TRUST_PROXY=true

# Port 465 uses implicit TLS; for port 587 set SMTP_SECURE=false (STARTTLS required).
SMTP_HOST=smtp.majordomo.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@pksep.ru
# Fill on server only. Never commit real secrets or put them in browser settings.
SMTP_PASSWORD=""
LEADS_HMAC_SECRET=""
LEADS_DB_PATH=/var/lib/sep-erp/leads.sqlite

# Both are enforced by code and cannot be changed to another mailbox.
MAIL_FROM=info@pksep.ru
MAIL_TO=info@pksep.ru

# Request limits: per IP / 10 minutes, globally / 10 minutes, min form age, SMTP concurrency.
LEADS_RATE_LIMIT=5
LEADS_GLOBAL_RATE_LIMIT=100
LEADS_MIN_FORM_MS=2000
LEADS_MAX_CONCURRENT=3
