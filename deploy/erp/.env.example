# SEP ERP — server-side outgoing mail configuration.
# Keep the working file outside the web server's document root.
# Port 465 uses implicit SSL/TLS, not STARTTLS.
SMTP_HOST=smtp.majordomo.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_AUTH=true
SMTP_USER=info@pksep.ru

# DevOps: fill in this value on the server only. Do not commit the password.
SMTP_PASSWORD=""

# The same mailbox sends and receives ERP landing-page enquiries.
MAIL_FROM=info@pksep.ru
MAIL_FROM_NAME="СЭП ERP"
MAIL_TO=info@pksep.ru
